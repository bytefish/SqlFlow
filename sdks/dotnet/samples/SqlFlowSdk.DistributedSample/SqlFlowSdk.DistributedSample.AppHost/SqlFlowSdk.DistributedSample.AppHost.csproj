<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UserSecretsId>ce454dd4-d4c3-403c-b969-c92083676314</UserSecretsId>
		    <AspireUseCliBundle>true</AspireUseCliBundle>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="docker\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\docker-compose.yml" Link="docker\docker-compose.yml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- Core host restored alongside NATS -->
		<PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.5" />
		<PackageReference Include="Aspire.Hosting.Nats" Version="13.6.5" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SqlFlowSdk.DistributedSample.DbDeployer\SqlFlowSdk.DistributedSample.DbDeployer.csproj" />
		<ProjectReference Include="..\SqlFlowSdk.DistributedSample.WorkerApp\SqlFlowSdk.DistributedSample.WorkerApp.csproj" />
	</ItemGroup>

</Project>