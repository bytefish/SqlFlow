    <artifactId>sqlflow-sqlserver</artifactId>
    
    <name>SQL Server Module</name>

    <dependencies>
        <dependency>
            <groupId>de.bytefish.sqlflow</groupId>
            <artifactId>sqlflow-core</artifactId>
